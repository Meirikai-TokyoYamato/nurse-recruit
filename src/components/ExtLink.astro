---
// 外部リンク（新しいタブで開く）。読み上げソフト向けに「新しいタブで開きます」を添える。
interface Props { href: string; class?: string }
const { href, class: cls } = Astro.props;
const isExternal = /^https?:/.test(href);
---
{isExternal ? (
  <a href={href} class={cls} target="_blank" rel="noopener noreferrer">
    <slot /><span class="visually-hidden">（新しいタブで開きます）</span>
  </a>
) : (
  <a href={href} class={cls}><slot /></a>
)}
