---
// ① トップ
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PhotoModal from '../components/PhotoModal.astro';
import site from '../data/site.json';
import { nurses, interviewed, featured, detailUrl, photoAlt, withBase } from '../lib/nurses';
import ExtLink from '../components/ExtLink.astro';

// インタビュー欄：featured 以外のインタビューのある人
const others = interviewed.filter((n) => n !== featured);
// 育てる仕組み：q4Quote が入っている人（featured を優先）
const quoteFrom = [featured, ...interviewed].find((n) => n?.q4Quote?.trim());
const joinedYear = nurses[0]?.joined.match(/\d{4}/)?.[0] ?? '';
---
<Base>
  {featured && (
    <section class="hero container" aria-labelledby="hero-title">
      <a class="hero__photo" href={detailUrl(featured)} tabindex="-1" aria-hidden="true">
        <Photo nurse={featured} kind="main" ratio="3/4" pcKind="wide" pcRatio="3/2" alt="" eager
               sizes="(min-width: 768px) 58vw, 100vw" />
      </a>
      <div class="hero__text">
        <p class="kicker-en" lang="en">{site.labels.hero}</p>
        <p class="kicker">新人看護師インタビュー</p>
        <h1 id="hero-title" class="hero__title">{featured.headline}</h1>
        <p class="caption hero__meta">{featured.department} ・ {featured.displayName} ・ {featured.joined}入職</p>
        <a class="btn hero__btn" href={detailUrl(featured)}>インタビューを読む</a>
      </div>
    </section>
  )}

  {others.length > 0 && (
    <section class="section container" aria-labelledby="interviews-title">
      <div class="section__head">
        <div>
          <p class="kicker-en" lang="en">{site.labels.interview}</p>
          <h2 id="interviews-title" class="section-title">インタビュー</h2>
        </div>
      </div>
      <ul class="iv-list">
        {others.map((n) => (
          <li>
            <a class="iv-card" href={detailUrl(n)}>
              <Photo nurse={n} kind="wide" ratio="3/2" alt={photoAlt(n)} sizes="(min-width: 768px) 33vw, 100vw" />
              <p class="caption">{n.department} ・ {n.displayName}</p>
              <p class="quote iv-card__quote">「{n.headline}」</p>
              <span class="iv-card__more">読む →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section container" aria-labelledby="peers-title">
    <div class="section__head">
      <div>
        <p class="kicker-en" lang="en">{site.labels.peers}</p>
        <h2 id="peers-title" class="section-title">{joinedYear}年入職の同期</h2>
      </div>
      <a class="more" href={withBase('nurses/')}>一覧を見る →</a>
    </div>
    <ul class="peers">
      {nurses.map((n) => (
        <li>
          <a class="peer" href={n.hasInterview ? detailUrl(n) : `#${n.slug}`}>
            <Photo nurse={n} kind="main" ratio="3/4" alt={photoAlt(n)} sizes="(min-width: 768px) 15vw, 33vw" />
            <span class="peer__cap caption">
              {n.department} ・ {n.displayName}
            </span>
            {n.hasInterview && <span class="tag">話を読む</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section container edu" aria-labelledby="edu-title">
    <div class="edu__head">
      <p class="kicker">育てる仕組み</p>
      <h2 id="edu-title" class="section-title">新人教育・研修</h2>
      <p class="edu__lead">{site.education.lead}</p>
      <ExtLink class="more" href={site.links.education}>教育体制を見る →</ExtLink>
    </div>
    {quoteFrom && (
      <figure class="edu__quote">
        <blockquote class="quote">「{quoteFrom.q4Quote}」</blockquote>
        <figcaption class="caption">
          <a href={detailUrl(quoteFrom)}>{quoteFrom.department} ・ {quoteFrom.displayName}</a>
        </figcaption>
      </figure>
    )}
  </section>

  <section id="recruit" class="section container recruit" aria-labelledby="recruit-title">
    <div class="section__head">
      <h2 id="recruit-title" class="section-title">募集要項（{site.recruit.target}）</h2>
    </div>
    <dl class="recruit__list">
      {site.recruit.items.map((it) => (
        <div>
          <dt class="caption">{it.label}</dt>
          <dd>{it.value}</dd>
        </div>
      ))}
    </dl>
    {site.recruit.note && <p class="caption recruit__note">{site.recruit.note}</p>}
    <div class="recruit__actions">
      <ExtLink class="btn" href={site.links.events}>見学・インターンシップ</ExtLink>
      <ExtLink class="btn btn--ghost" href={site.links.exam}>採用試験</ExtLink>
      <ExtLink class="more" href={site.recruit.detailUrl}>募集要項をすべて見る →</ExtLink>
    </div>
  </section>

  <PhotoModal />
</Base>

<style>
  /* ヒーロー：スマホは写真→テキスト、PCは 7:5 の2カラムでテキスト下揃え */
  .hero { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-1); }
  .hero__photo { display: block; margin-inline: calc(var(--gutter) * -1); text-decoration: none; }
  .hero__text { display: flex; flex-direction: column; gap: var(--space-2); }
  .hero__text .kicker-en { margin-bottom: calc(var(--space-2) * -1 + 2px); }
  .section__head .kicker-en { margin-bottom: 4px; }
  .hero__title { font-size: 24px; line-height: 1.45; }
  .hero__btn { align-self: flex-start; margin-top: var(--space-2); }
  @media (min-width: 768px) {
    .hero { display: grid; grid-template-columns: 7fr 5fr; gap: var(--space-6); align-items: end; }
    .hero__photo { margin-inline: 0; }
    .hero__title { font-size: 38px; line-height: 1.4; }
  }

  /* インタビュー：スマホ縦並び／PC横3列 */
  .iv-list { display: grid; gap: var(--space-5); }
  @media (min-width: 768px) { .iv-list { grid-template-columns: repeat(3, 1fr); } }
  .iv-card { display: flex; flex-direction: column; gap: var(--space-1); color: var(--color-text); text-decoration: none; }
  .iv-card :global(.photo) { margin-bottom: var(--space-1); }
  .iv-card__quote { font-size: 17px; line-height: 1.6; }
  .iv-card__more { font-family: var(--font-sans); font-size: 14px; font-weight: 600; color: var(--color-accent-text); }
  .iv-card:hover .iv-card__quote { text-decoration: underline; }

  /* 同期：スマホ3列／PC7列（全員同じ大きさ） */
  .peers { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4) var(--space-2); }
  @media (min-width: 768px) { .peers { grid-template-columns: repeat(7, 1fr); gap: var(--space-4) var(--space-3); } }
  .peer { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; color: var(--color-text); text-decoration: none; min-height: 44px; }
  .peer__cap { color: var(--color-text); }
  .peer:hover .peer__cap { text-decoration: underline; }

  /* 育てる仕組み */
  .edu { display: grid; gap: var(--space-5); }
  .edu__head { display: flex; flex-direction: column; gap: var(--space-2); }
  .edu__lead { max-width: 36em; }
  .edu__quote { margin: 0; padding-left: var(--space-4); box-shadow: inset 2px 0 0 var(--color-accent); }
  .edu__quote blockquote { margin: 0 0 var(--space-2); font-size: 18px; line-height: 1.7; }
  @media (min-width: 768px) {
    .edu { grid-template-columns: 5fr 7fr; gap: var(--space-6); align-items: center; }
    .edu__quote blockquote { font-size: 22px; }
  }

  /* 募集要項 */
  .recruit__list { display: grid; gap: var(--space-3); margin: 0 0 var(--space-3); }
  .recruit__note { margin-bottom: var(--space-5); }
  .recruit__list dd { margin: 0; }
  @media (min-width: 768px) { .recruit__list { grid-template-columns: repeat(3, 1fr); gap: var(--space-4) var(--space-5); } }
  .recruit__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
</style>
