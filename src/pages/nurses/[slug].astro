---
// ③ インタビュー詳細（hasInterview: true の人だけページを作る）
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import BoardZoom from '../../components/BoardZoom.astro';
import site from '../../data/site.json';
import ExtLink from '../../components/ExtLink.astro';
import { interviewed, questions, detailUrl, photoAlt, withBase, photoSource, type Nurse } from '../../lib/nurses';

export function getStaticPaths() {
  return interviewed.map((nurse, i) => ({
    params: { slug: nurse.slug },
    props: { nurse, index: i },
  }));
}

interface Props { nurse: Nurse; index: number }
const { nurse: n, index } = Astro.props;
const total = interviewed.length;
const next = interviewed[(index + 1) % total];
const iv = n.interview ?? {};
const has = (s?: string) => !!s && s.trim() !== '';

// 回答が空の設問は見出しごと出さない
const items = questions
  .filter((q) => has(iv[q.key]))
  .map((q) => ({ ...q, no: String(questions.indexOf(q) + 1).padStart(2, '0'), text: iv[q.key]! }));
const message = iv.q9;
// 本文写真（work・team）：変換済みの写真がある分だけ出す（0枚ならブロックごと出さない）
const showBodyPhoto = (k: 'work' | 'team') => !!photoSource(n, k);

const profile = [
  `${n.joined}入職`,
  n.showSchool && has(n.school) ? `${n.school}卒` : null,
  n.showHometown && has(n.hometown) ? `${n.hometown}出身` : null,
].filter(Boolean).join(' ・ ');

const paragraphs = (t: string) => t.split(/\n+/).filter((p) => p.trim());
---
<Base
  title={`${n.department} ${n.displayName}のインタビュー`}
  description={n.headline || `${n.department}で働く${n.displayName}のインタビュー`}
>
  <div class="container topbar">
    <a class="back caption" href={withBase('nurses/')}>← 1年生一覧</a>
    <span class="caption">インタビュー {index + 1} / {total}</span>
  </div>

  <header class="container lead">
    <Photo nurse={n} kind="wide" ratio="3/2" alt={photoAlt(n)} class="lead__photo" eager
           sizes="(min-width: 768px) 58vw, 100vw" />
    <div class="lead__text">
      <p class="kicker">新人看護師インタビュー</p>
      <h1 class="lead__title">{n.headline}</h1>
      <p class="lead__name">{n.department} ・ {n.displayName}</p>
      <p class="caption">{profile}</p>
    </div>
  </header>

  <div class="container body">
    <nav class="toc" aria-label="目次">
      <ol>
        {items.map((q) => (
          <li><a href={`#${q.key}`} data-toc={q.key}><span class="toc__no">{q.no}</span>{q.title}</a></li>
        ))}
        {has(message) && <li><a href="#message" data-toc="message">看護学生のみなさんへ</a></li>}
      </ol>
    </nav>

    <article class="article">
      {items.map((q) => (
        <>
          <section id={q.key} class="qa" data-section>
            <h2 class="qa__title"><span class="qa__no">{q.no}</span>{q.title}</h2>
            {paragraphs(q.text).map((p) => <p>{p}</p>)}
            {q.key === 'q4' && <ExtLink class="more" href={site.links.education}>教育体制を見る →</ExtLink>}
          </section>
          {q.key === 'q4' && showBodyPhoto('work') && (
            <figure class="body-photo">
              <Photo nurse={n} kind="work" ratio="3/2" sizes="(min-width: 1024px) 50vw, 100vw" alt={`${n.department}で働く${n.displayName}の様子`} />
            </figure>
          )}
          {q.key === 'q6' && showBodyPhoto('team') && (
            <figure class="body-photo">
              <Photo nurse={n} kind="team" ratio="3/2" sizes="(min-width: 1024px) 50vw, 100vw" alt={`${n.department}の同期・先輩と${n.displayName}`} />
            </figure>
          )}
        </>
      ))}

      {has(message) && (
        <section id="message" class="message" data-section>
          <h2 class="kicker">看護学生のみなさんへ</h2>
          <blockquote class="quote message__text">
            {paragraphs(message!).map((p) => <p>{p}</p>)}
          </blockquote>
          <p class="caption">{n.department} ・ {n.displayName}</p>
        </section>
      )}

      {/* ボード（board.jpg）：切り抜かず元の比率のまま。ある人だけ出す */}
      {photoSource(n, 'board') && (
        <figure class="body-photo board">
          <BoardZoom nurse={n} sizes="(min-width: 1024px) 50vw, 100vw" />
        </figure>
      )}
    </article>
  </div>

  <div class="container after">
    {total > 1 && (
      <a class="next" href={detailUrl(next)}>
        <Photo nurse={next} kind="main" ratio="3/4" alt="" class="next__photo" sizes="88px" />
        <span class="next__text">
          <span class="caption">次のインタビュー</span>
          <span class="next__name">{next.department} ・ {next.displayName} →</span>
        </span>
      </a>
    )}
    <div class="after__actions">
      <ExtLink class="btn" href={site.links.events}>見学・インターンシップ</ExtLink>
      <ExtLink class="more" href={site.links.exam}>採用試験について →</ExtLink>
    </div>
  </div>
</Base>

<style>
  .topbar { display: flex; justify-content: space-between; align-items: center; padding-block: var(--space-1) var(--space-2); }
  .back { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--color-accent-text); }

  /* メイン写真＋見出し */
  .lead { display: flex; flex-direction: column; gap: var(--space-4); }
  .lead :global(.lead__photo) { margin-inline: calc(var(--gutter) * -1); width: calc(100% + var(--gutter) * 2); max-width: none; }
  .lead__text { display: flex; flex-direction: column; gap: var(--space-2); }
  .lead__title { font-size: 24px; line-height: 1.45; }
  .lead__name { font-weight: 600; margin-top: var(--space-1); }
  @media (min-width: 768px) {
    .lead { display: grid; grid-template-columns: 7fr 5fr; gap: var(--space-6); align-items: end; }
    .lead :global(.lead__photo) { margin-inline: 0; width: 100%; }
    .lead__title { font-size: 34px; line-height: 1.4; }
  }

  /* 本文：PCは 左3（目次）：中央7（本文）：右2 */
  .body { margin-top: 56px; }
  .toc { display: none; }
  .article { max-width: 38em; margin-inline: auto; }
  @media (min-width: 1024px) {
    .body { display: grid; grid-template-columns: 3fr 7fr 2fr; gap: var(--space-6); margin-top: 80px; }
    .article { margin-inline: 0; }
    .toc { display: block; }
    .toc ol { position: sticky; top: calc(64px + var(--space-5)); display: flex; flex-direction: column; }
    .toc a {
      display: flex; gap: var(--space-2); align-items: baseline; padding: 6px 0;
      color: var(--color-neutral-700); text-decoration: none; font-family: var(--font-sans); font-size: 13px; line-height: 1.5;
    }
    .toc a:hover { color: var(--color-accent-text); }
    .toc a[aria-current='true'] { color: var(--color-accent-text); font-weight: 600; }
    .toc__no { font-variant-numeric: tabular-nums; min-width: 1.6em; }
  }

  .qa { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: 48px; scroll-margin-top: var(--space-4); }
  .qa__title { font-size: 19px; display: flex; gap: var(--space-2); align-items: baseline; }
  @media (min-width: 768px) { .qa__title { font-size: 22px; } }
  .qa__no { color: var(--color-accent-text); font-size: 0.8em; font-variant-numeric: tabular-nums; }
  .qa :global(.more) { align-self: flex-start; }
  .body-photo { margin: 0 0 48px; }
  .board { margin-top: 72px; }

  .message { margin-top: 72px; scroll-margin-top: var(--space-4); }
  .message__text { margin: var(--space-3) 0 var(--space-3); font-size: 21px; line-height: 1.75; }
  .message__text p + p { margin-top: 1em; }
  @media (min-width: 768px) { .message__text { font-size: 26px; } }

  /* 次のインタビュー・見学ボタン・採用試験 */
  .after { display: flex; flex-direction: column; gap: var(--space-5); margin-top: 72px; }
  .next { display: flex; align-items: center; gap: var(--space-3); color: var(--color-text); text-decoration: none; }
  .next :global(.next__photo) { width: 88px; flex: none; }
  .next__text { display: flex; flex-direction: column; }
  .next__name { font-weight: 600; font-size: 17px; }
  .next:hover .next__name { color: var(--color-accent-text); }
  .after__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  @media (min-width: 768px) {
    .after { flex-direction: row; justify-content: space-between; align-items: center; }
  }
</style>

<script>
  // 目次：いま読んでいる設問をアクセント色にする
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]),
  );
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  if (links.size && 'IntersectionObserver' in window) {
    const visible = new Set<string>();
    const update = () => {
      const current = sections.find((s) => visible.has(s.id))?.id;
      if (!current) return; // 写真の位置などでは直前の表示のまま
      links.forEach((a, id) => a.setAttribute('aria-current', String(id === current)));
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        update();
      },
      { rootMargin: '-20% 0px -60% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
