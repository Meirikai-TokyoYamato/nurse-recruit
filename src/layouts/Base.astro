---
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExtLink from '../components/ExtLink.astro';
import BoardLightbox from '../components/BoardLightbox.astro';
import { photoExists, withBase } from '../lib/nurses';

interface Props {
  title?: string;
  description?: string;
  /** OGP 画像（public/ からのパス）。なければ共通の og.png */
  ogImage?: string;
  /** スマホ下端の「見学・インターンシップ」ボタンを出すか */
  stickyCta?: boolean;
}
const { title, description = site.description, ogImage, stickyCta = true } = Astro.props;
const siteTitle = site.siteName;
const fullTitle = title ? `${title}｜${siteTitle}` : siteTitle;
const ogPath = ogImage && photoExists(ogImage) ? ogImage : 'og.png';
const ogUrl = new URL(withBase(ogPath), Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={[{ 'has-sticky-cta': stickyCta }]}>
    <a class="skip" href="#main">本文へスキップ</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BoardLightbox />
    {stickyCta && (
      <div class="sticky-cta">
        <ExtLink class="btn btn--block" href={site.links.events}>見学・インターンシップ</ExtLink>
      </div>
    )}
  </body>
</html>

<style is:global>
  .skip {
    position: absolute; left: 8px; top: -60px; z-index: 100;
    padding: 8px 12px; background: var(--color-text); color: #fff; font-family: var(--font-sans);
  }
  .skip:focus { top: 8px; color: #fff; }
  .sticky-cta {
    position: fixed; inset: auto 0 0 0; z-index: 40;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: rgb(243 242 242 / 0.94);
    box-shadow: 0 -1px 0 var(--color-divider);
    backdrop-filter: blur(6px);
  }
  body.has-sticky-cta { padding-bottom: 72px; }
  @media (min-width: 768px) {
    .sticky-cta { display: none; }
    body.has-sticky-cta { padding-bottom: 0; }
  }
</style>
